# Application
NODE_ENV=production
APP_URL=https://your-app.vercel.app

# Neon PostgreSQL (pooled + direct for migrations if needed)
DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require

# Auth.js
AUTH_SECRET=replace-with-32+-char-random-secret
AUTH_TRUST_HOST=true
# Google OAuth (optional). Callback: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cron (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=replace-with-32+-char-random-secret

# Security gates (default: mock/auth-codes on in non-production, off in production)
# ALLOW_MOCK_PAYMENTS=false
# ALLOW_SIMULATED_AUTH_CODES=false

# Cloudflare R2 (optional until uploads needed)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Market data (single provider each; no fallback)
EXCHANGE_RATE_API_URL=
EXCHANGE_RATE_API_KEY=
CRYPTO_PRICE_API_URL=
CRYPTO_PRICE_API_KEY=
RATE_MAX_AGE_MS=900000

# Bootstrap Super Admin (seed only)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Optional pool size override (Vercel defaults to 1)
# DB_POOL_MAX=1
